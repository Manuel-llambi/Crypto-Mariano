# The local Supabase instance, versioned on purpose.
#
# Both values are public and identical on every machine `supabase start` runs
# on, so committing them exposes nothing and keeps the project value that
# nothing has to be configured to build: clone, `npm run build`, done.
#
# `.env.local` is gitignored and overrides this file. That is where a hosted
# instance would go the day one exists.
#
# The address is the API port declared in `supabase/config.toml`. It is not the
# 54321 default: Hyper-V reserves 54268-54367 on this machine.
SUPABASE_URL=http://127.0.0.1:55321

# The publishable key, the one meant to travel to a browser. The secret key is
# never read by this application (6.3).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
